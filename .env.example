# Backblaze B2 (required) — S3-compatible API, standard B2_* names
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_region

# Optional: public base URL for object links (CDN or bucket friendly URL).
# Leave empty to fall back to short-lived presigned URLs in the UI.
B2_PUBLIC_URL_BASE=

# DeOldify colorization service (Docker, native linux/arm64). The API POSTs
# image bytes here to colorize; `pnpm dev` builds + runs the container for you.
# Change the port only if 8137 is taken (keep the two in sync).
DEOLDIFY_SERVICE_URL=http://localhost:8137
DEOLDIFY_SERVICE_PORT=8137

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K000xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# B2_BUCKET_NAME=my-archive-bucket
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-archive-bucket.s3.us-west-004.backblazeb2.com
